            );
          }
          const { data, error } = await query;
          if (error) throw error;
          if(requestScope!==pageCache.getScope()||request!==logsRequestRef.current)return;
          setLogs(data || []);
        } catch (error) {
          if(requestScope===pageCache.getScope()&&request===logsRequestRef.current){setLogsError(errorText(error));setLogs([]);}
        } finally {
          if(requestScope===pageCache.getScope()&&request===logsRequestRef.current)setLogsLoading(false);
