          setForm(previous=>keepContext?{...previous,quantity:'',note:''}:{...previous,product:'',color:'',quantity:'',note:''});
          if(!keepContext)setAdvanced(DEFAULT_ADVANCED_FIELDS);
          pendingPayloadRef.current=null;
        };
        try{
