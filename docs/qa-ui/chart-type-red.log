                    className={INPUT_CLASS}
                  >
                    {["ARCHIVE", "EMAIL", "WEBHOOK", "TELEGRAM", "WHATSAPP"].map(
                      (value) => (
                        <option key={value} value={value}>
                          {channelLabel(value)}
