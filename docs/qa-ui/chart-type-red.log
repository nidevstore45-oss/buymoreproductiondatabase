          )
          .on('postgres_changes',{event:'*',schema:'public',table:'buymore_user_factories',filter:`user_id=eq.${session.user.id}`},()=>{clearPageCache(false);void loadProfile(session);})
          .subscribe();
        return () => {
          if (realtimeTimerRef.current)
            window.clearTimeout(realtimeTimerRef.current);
          supabase.removeChannel(productionChannel);
          supabase.removeChannel(supportChannel);
        };
      }, [session?.user?.id, profile?.role, profile?.is_active]);
      const saveQueue = (next:any[]) => {
        if(queueKey)localStorage.setItem(queueKey,JSON.stringify(next));
        queueItemsRef.current=next;setOfflineQueue(next);
      };
      const enqueueOffline=(payload:any)=>{
        if(queueItemsRef.current.some(item=>item.id===payload.client_request_id))return;
        saveQueue([...queueItemsRef.current,{id:payload.client_request_id,payload,queued_at:new Date().toISOString(),attempts:0}]);
      };
      const flushOfflineQueue=async()=>{
        if(queueFlightRef.current||!online||!session?.user?.id||!profile?.is_active||!queueItemsRef.current.length)return;
        queueFlightRef.current=true;const userId=session.user.id;const snapshot=[...queueItemsRef.current];const results:any[]=[];
        try{
          for(const item of snapshot){
            if(activeUserRef.current!==userId)break;
            try{await productionApi.submit(item.payload);results.push({id:item.id,ok:true});}
            catch(error){results.push({id:item.id,ok:false,error:errorText(error)});}
          }
          if(activeUserRef.current!==userId)return;
          const remaining=reconcileQueue(queueItemsRef.current,results);
          saveQueue(remaining);
          if(results.some(r=>r.ok)){setProductionRefresh(n=>n+1);setWorkflowMessage(bi('Data antrean yang berhasil dikonfirmasi telah tersimpan.','已确认的队列数据已保存。'));}
          const failed=results.find(r=>!r.ok);if(failed)setDataError(bi('Antrean belum tersimpan: ','队列尚未保存： ')+failed.error);
        }catch(error){setDataError(errorText(error));}finally{queueFlightRef.current=false;}
      };
      useEffect(()=>{void flushOfflineQueue();},[online,session?.user?.id,profile?.is_active]);
    
