                                    >
                                      {bi("Detail ", "详情 ")}
                                    </button>
                                    {manager&&<button disabled={loading||reviewBusy} onClick={()=>setCorrectionRecord(row)} className={`${SMALL_BUTTON} ml-2`}>{bi('Koreksi','更正')}</button>}
                                    {manager&&['LEGACY','SUBMITTED'].includes(row.verification_status)&&<><button disabled={loading||reviewBusy} onClick={()=>{setReviewRecord(row);setReviewDecision('VERIFIED');setReviewReason('');setDataError('');}} className={`${SMALL_BUTTON} ml-2 !text-emerald-700`}>{bi('Verifikasi','审核')}</button><button disabled={loading||reviewBusy} onClick={()=>{setReviewRecord(row);setReviewDecision('REJECTED');setReviewReason('');setDataError('');}} className={`${SMALL_BUTTON} ml-2 !text-red-600`}>{bi('Tolak','拒绝')}</button></>}
                                  </td>
                                )}
                              </tr>
                            ))
