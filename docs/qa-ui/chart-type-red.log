      const duplicateExists = async (payload: any) => {
        if (!setting("enable_duplicate_check", true)) return false;
        const minutes = Math.max(
          numberValue(setting("duplicate_window_minutes", 5)),
          1,
        );
        const threshold = new Date(Date.now() - minutes * 60_000).toISOString();
        const { data, error } = await supabase
          .from("production_data")
          .select("id,created_at,created_by")
          .eq("date", payload.date)
          .eq("shift_master_code", resolveMasterCode(masterItems,"SHIFT",payload.shift))
          .eq("product_master_code", resolveMasterCode(masterItems,"PRODUCT",payload.product))
          .eq("quantity", payload.quantity)
          .eq("color_master_code", resolveMasterCode(masterItems,"COLOR",payload.color))
          .eq("factory_code", payload.factory_code)
          .eq("created_by_id", session.user.id)
          .is("deleted_at", null)
          .gte("created_at", threshold)
          .limit(1);
        if(error)throw error;
        return Boolean(data?.length);
      };
